# Read-only audit on isolated Railway service; no application server, no data volume.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 THAI_ENGINE_IMPL=legacy
WORKDIR /app
COPY . /app
CMD ["sh","-c","python -u -m unittest test_planner test_planner_postflop_ev -q 2>&1 || python -u -m unittest test_planner -q; python -u scripts/audit_planner_mc.py"]
